<Layouts.app flash={@flash} current_user={@current_user}>
  <section class="card bg-base-200">
    <div class="card-body">
      <h1 class="card-title text-2xl">Start a retro</h1>
      <p class="text-base-content/70">Pick a format, then share the link with your team.</p>
      <.form for={%{}} action={~p"/retros"} method="post" class="mt-2 space-y-4">
        <fieldset>
          <legend class="sr-only">Format</legend>
          <div class="grid gap-3 sm:grid-cols-2">
            <label
              :for={{format, i} <- Enum.with_index(@formats)}
              class="flex cursor-pointer items-start gap-3 rounded-box border border-base-300 bg-base-100 p-4 transition hover:border-primary has-checked:border-primary has-checked:ring-2 has-checked:ring-primary/30"
            >
              <input
                type="radio"
                name="format"
                value={format}
                class="radio radio-primary mt-0.5"
                checked={i == 0}
              />
              <span>
                <span class="block font-medium">{format_name(format)}</span>
                <span class="block text-sm text-base-content/60">
                  {if format == "happy_sad_confused",
                    do: "Reflect on how the last sprint felt.",
                    else: "Tune the team's habits and practices."}
                </span>
              </span>
            </label>
          </div>
        </fieldset>
        <button class="btn btn-primary">
          <.icon name="hero-plus" class="size-5" /> Create retro
        </button>
      </.form>
    </div>
  </section>

  <section class="mt-12">
    <h2 class="text-lg font-semibold">Your retros</h2>
    <div
      :if={@retros == []}
      class="mt-4 rounded-box border border-dashed border-base-300 p-8 text-center text-base-content/60"
    >
      No retros yet. Create one above to get started.
    </div>
    <ul :if={@retros != []} class="mt-4 space-y-2">
      <li :for={retro <- @retros}>
        <details class="group rounded-box border border-base-300 bg-base-100 open:shadow-sm">
          <summary class="flex cursor-pointer list-none items-center gap-4 px-4 py-3 transition hover:bg-base-200 [&::-webkit-details-marker]:hidden">
            <.icon
              name="hero-chevron-right-micro"
              class="size-4 shrink-0 text-base-content/50 transition group-open:rotate-90"
            />
            <span class="min-w-0 flex-1">
              <span class="block font-semibold">{retro_date(retro)}</span>
              <span class="block text-sm text-base-content/60">{format_name(retro.format)}</span>
            </span>
            <span
              :if={(n = length(Map.get(@my_action_items, retro.id, []))) > 0}
              class="badge badge-sm badge-soft badge-secondary shrink-0"
            >
              {n} {if n == 1, do: "action item", else: "action items"} for you
            </span>
            <span class={[
              "badge badge-sm shrink-0",
              if(retro.stage == "closed", do: "badge-ghost", else: "badge-primary badge-soft")
            ]}>
              {stage_name(retro.stage)}
            </span>
          </summary>
          <div class="border-t border-base-300 px-4 py-3 pl-12">
            <%= case Map.get(@my_action_items, retro.id, []) do %>
              <% [] -> %>
                <p class="text-sm text-base-content/60">No action items assigned to you.</p>
              <% items -> %>
                <p class="text-xs font-medium tracking-wide text-base-content/60 uppercase">
                  Your action items
                </p>
                <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
                  <li :for={item <- items} class="break-words">
                    <span class="whitespace-pre-wrap">{item.body}</span>
                  </li>
                </ul>
            <% end %>
            <.link navigate={~p"/retros/#{retro.id}"} class="btn btn-sm btn-ghost mt-3 -ml-3">
              Open retro <.icon name="hero-arrow-right-micro" class="size-4" />
            </.link>
          </div>
        </details>
      </li>
    </ul>
  </section>
</Layouts.app>
