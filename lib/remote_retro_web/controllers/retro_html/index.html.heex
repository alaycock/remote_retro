<Layouts.app flash={@flash} current_user={@current_user}>
  <section class="space-y-4">
    <h1 class="text-2xl font-semibold">Start a retro</h1>
    <.form for={%{}} action={~p"/retros"} method="post" class="flex flex-wrap items-end gap-3">
      <fieldset class="fieldset">
        <legend class="fieldset-legend">Format</legend>
        <div class="flex gap-4">
          <label :for={{format, i} <- Enum.with_index(@formats)} class="label gap-2">
            <input type="radio" name="format" value={format} class="radio" checked={i == 0} />
            {format_name(format)}
          </label>
        </div>
      </fieldset>
      <button class="btn btn-primary">Create retro</button>
    </.form>
  </section>

  <section class="mt-10 space-y-3">
    <h2 class="text-lg font-semibold">Your retros</h2>
    <p :if={@retros == []} class="text-base-content/70">No retros yet.</p>
    <ul class="divide-y divide-base-300">
      <li :for={retro <- @retros} class="py-3 flex items-center justify-between gap-4">
        <.link navigate={~p"/retros/#{retro.id}"} class="link link-hover">
          {format_name(retro.format)}
        </.link>
        <span class="text-sm text-base-content/70">
          {stage_name(retro.stage)} · {Calendar.strftime(retro.inserted_at, "%b %-d, %Y")}
        </span>
      </li>
    </ul>
  </section>
</Layouts.app>
