<Layouts.app flash={@flash} current_user={@current_user} wide>
  <section class="mx-auto max-w-2xl text-center">
    <span class="badge badge-ghost mb-4">Free · Open source</span>
    <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
      Retrospectives your remote team will actually enjoy
    </h1>
    <p class="mt-5 text-lg text-base-content/70">
      Collect ideas in real time, group them on a shared board, vote on what matters, and leave with clear action items.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={~p"/auth/google"} class="btn btn-primary btn-lg">
        <.icon name="hero-arrow-right-end-on-rectangle" class="size-5" /> Sign in with Google
      </a>
    </div>
  </section>

  <section class="mt-20 grid gap-4 sm:grid-cols-3" aria-label="Features">
    <div
      :for={
        {icon, title, body} <- [
          {"hero-light-bulb", "Share ideas together",
           "Everyone adds ideas at once. See them appear live, with a gentle typing indicator."},
          {"hero-squares-2x2", "Group on a shared board",
           "Drag sticky notes on an infinite canvas. Gemini can pre-group the obvious ones."},
          {"hero-check-badge", "Vote and commit",
           "Blind voting surfaces what matters most. Finish with owned action items."}
        ]
      }
      class="card bg-base-200"
    >
      <div class="card-body">
        <span class="grid size-10 place-items-center rounded-lg bg-primary/15 text-primary">
          <.icon name={icon} class="size-6" />
        </span>
        <h2 class="card-title mt-2 text-base">{title}</h2>
        <p class="text-sm text-base-content/70">{body}</p>
      </div>
    </div>
  </section>

  <section class="mx-auto mt-20 max-w-3xl" aria-labelledby="faq-heading">
    <h2 id="faq-heading" class="text-center text-2xl font-semibold">Questions</h2>
    <div class="mt-6 space-y-2">
      <details
        :for={
          {question, answer} <- [
            {"What's a retro?",
             "Short for retrospective: a regular meeting where a team reflects on its recent work, identifies what to improve, and agrees on action items to make those improvements."},
            {"How much does it cost?", "Nothing. Remote Retro is free and open source."},
            {"Who can join?",
             "Anyone with a Google account who has the retro's link. Share the link from the lobby."},
            {"How does a retro work here?",
             "The facilitator guides everyone through each stage: the Prime Directive, sharing ideas, grouping and labeling them, voting, and agreeing on action items. Facilitators can step back a stage at any time, and re-open a closed retro."},
            {"What does the AI do?",
             "When enabled, Google's Gemini groups only clearly related ideas when you start grouping, and names a group only when an obvious title exists. Everything it does can be changed by hand."},
            {"How many people should take part?",
             "Ideally no more than about ten. Larger groups make it easy for people to disengage."},
            {"How long should a retro take?",
             "Budget about an hour for a sprint retrospective. Much shorter tends to stay on the surface; much longer tends to tire people out."},
            {"Our team is in one room. Should we use it?",
             "It works well on a shared screen for ideas, grouping and voting. During discussion and action items, put laptops away and talk face to face."}
          ]
        }
        class="collapse-arrow collapse border border-base-300 bg-base-100"
      >
        <summary class="collapse-title font-medium">{question}</summary>
        <div class="collapse-content text-base-content/75">
          <p>{answer}</p>
        </div>
      </details>
      <details class="collapse-arrow collapse border border-base-300 bg-base-100">
        <summary class="collapse-title font-medium">How is my data handled?</summary>
        <div class="collapse-content text-base-content/75">
          <p>See the <a href={~p"/privacy"} class="link">privacy policy</a>.</p>
        </div>
      </details>
    </div>
  </section>
</Layouts.app>
