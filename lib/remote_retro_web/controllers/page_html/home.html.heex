<Layouts.app flash={@flash} current_user={@current_user} wide>
  <section class="mx-auto max-w-2xl text-center">
    <span class="badge badge-ghost mb-4">Free · Open source</span>
    <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
      Retrospectives your remote team will actually enjoy
    </h1>
    <p class="mt-5 text-lg text-base-content/70">
      Collect ideas in real time, group them on a shared board, vote on what matters, and leave with clear action items.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={~p"/auth/google"} class="btn btn-primary btn-lg">
        <.icon name="hero-arrow-right-end-on-rectangle" class="size-5" /> Sign in with Google
      </a>
    </div>
  </section>

  <section class="mt-20 grid gap-4 sm:grid-cols-3" aria-label="Features">
    <div
      :for={
        {icon, title, body} <- [
          {"hero-light-bulb", "Share ideas together",
           "Everyone adds ideas at once. See them appear live, with a gentle typing indicator."},
          {"hero-squares-2x2", "Group on a shared board",
           "Drag sticky notes on an infinite canvas. Gemini can pre-group the obvious ones."},
          {"hero-check-badge", "Vote and commit",
           "Blind voting surfaces what matters most. Finish with owned action items."}
        ]
      }
      class="card bg-base-200"
    >
      <div class="card-body">
        <span class="grid size-10 place-items-center rounded-lg bg-primary/15 text-primary">
          <.icon name={icon} class="size-6" />
        </span>
        <h2 class="card-title mt-2 text-base">{title}</h2>
        <p class="text-sm text-base-content/70">{body}</p>
      </div>
    </div>
  </section>

  <section class="mt-16 text-center" aria-labelledby="flow-heading">
    <h2 id="flow-heading" class="text-lg font-semibold">How a retro flows</h2>
    <ol class="mt-4 flex flex-wrap items-center justify-center gap-x-2 gap-y-2 text-sm text-base-content/80">
      <li
        :for={{step, i} <- Enum.with_index(~w(Share Group Vote Act))}
        class="flex items-center gap-2"
      >
        <.icon :if={i > 0} name="hero-arrow-long-right" class="size-4 text-base-content/40" />
        <span class="rounded-full bg-base-200 px-3 py-1 font-medium">{step}</span>
      </li>
    </ol>
  </section>
</Layouts.app>
