<Layouts.app flash={@flash} current_user={@current_user}>
  <section class="space-y-6 text-center">
    <h1 class="text-4xl font-bold">Remote Retro</h1>
    <p class="text-lg text-base-content/80">
      Real-time retrospectives for distributed teams: collect ideas, group them on a shared board, vote, and leave with action items.
    </p>
    <a href={~p"/auth/google"} class="btn btn-primary btn-lg">Sign in with Google</a>
  </section>
</Layouts.app>
