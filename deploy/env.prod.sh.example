# Copy to deploy/env.prod.sh (gitignored) and fill in the PRODUCTION OAuth client
# (a Web application client in the same project). Authorized redirect URI on that client:
#   https://remote-retro-<project-number>.us-central1.run.app/auth/google/callback
# (deploy.sh prints the exact URI).
export REMOTE_RETRO_GOOGLE_OAUTH_CLIENT_ID=
export REMOTE_RETRO_GOOGLE_OAUTH_CLIENT_SECRET=

# Optional: send the action-item email on close. Without a key emails are only logged.
# export SENDGRID_API_KEY=
# export MAIL_FROM='"Remote Retro" <retro@example.com>'
